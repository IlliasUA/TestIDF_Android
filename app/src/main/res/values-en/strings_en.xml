    <!-- Section 1: Privacy Policy -->
    <string name="info_privacy_title">1. Privacy Policy</string>

    <string name="info_privacy_intro_subtitle">Introduction</string>
    <string name="info_privacy_intro_content">This Privacy Policy describes how the \"Tanks Hunter: Quiz\" application (\"the Application\") collects, uses, and protects user information. The Application operates primarily offline and does not collect any personal data. However, the \"Collective Test\" mode requires an Internet connection to enable real-time multiplayer gaming and may result in the collection and storage of certain information.</string>

    <string name="info_privacy_data_subtitle">Data Collected</string>
    <string name="info_privacy_data_content">- Offline mode: No personal data is collected. All offline features work without requiring a connection or external storage.\n\n- \"Collective Test\" mode (requires Internet):\n\nTo enable real-time multiplayer mode, we temporarily collect the following information:\n\n- Username or pseudonym provided by the user\n- Test results (score, answers)\n- Group session data (group codes, session identifiers)\n\nThis data is stored temporarily on a remote server and is used only to manage group sessions and display results in real time.</string>

    <string name="info_privacy_usage_subtitle">Data Usage</string>
    <string name="info_privacy_usage_content">Data collected in \"Collective Test\" mode is used solely for:\n\n- Displaying participant results in group sessions\n- Enabling score comparison between users\n- Managing test sessions in real time\n\nThis information is not shared with third parties for commercial purposes and is kept only for the time necessary for the collective mode to function.</string>

    <string name="info_privacy_security_subtitle">Security</string>
    <string name="info_privacy_security_content">We take reasonable measures to protect data stored as part of \"Collective Test\" mode. Data is transmitted and stored securely. However, no method of transmission over the Internet or electronic storage is completely secure, and we cannot guarantee absolute security.</string>

    <string name="info_privacy_children_subtitle">Children\'s Privacy</string>
    <string name="info_privacy_children_content">The Application is not recommended for children under 14 years of age. We do not knowingly collect personal information from children under 14 years of age. If you are a parent or guardian and believe your child has provided us with personal information, please contact us at tanks.hunterquiz@gmail.com so we can take appropriate action.</string>

    <string name="info_privacy_changes_subtitle">Privacy Policy Changes</string>
    <string name="info_privacy_changes_content">We may update this Privacy Policy from time to time. Any changes will be posted in the Application or on this page with a revised update date. We encourage you to review this policy regularly.</string>

    <string name="info_privacy_contact_subtitle">Contact Us</string>
    <string name="info_privacy_contact_content">If you have any questions regarding this Privacy Policy, please contact us at: tanks.hunterquiz@gmail.com</string>

    <!-- Section 2: Terms of Use -->
    <string name="info_terms_title">2. Terms of Use</string>

    <string name="info_terms_acceptance_subtitle">Acceptance of Terms</string>
    <string name="info_terms_acceptance_content">By downloading, installing, and using the Tanks Hunter: Quiz application (\"the Application\"), you agree to be bound by these Terms of Use (\"Terms\"). If you do not accept these Terms, please do not use the Application.</string>

    <string name="info_terms_description_subtitle">Application Description</string>
    <string name="info_terms_description_content">The Application offers educational and informative tests on military equipment, organized into several categories, with a final test. The Application operates primarily offline and does not require an Internet connection for most of its features. However, the \"Collective Test\" mode requires a stable Internet connection to enable real-time multiplayer gaming, results synchronization, and group session management.</string>

    <string name="info_terms_usage_subtitle">Permitted Use</string>
